{
  "name": "cloakshot",
  "version": "1.0.0",
  "private": true,
  "description": "CloakShot — 100% browser-local privacy & demo studio for webpages (Blur, Redact, Smart Mock Swap & Dual Scroll Capture).",
  "type": "module",
  "scripts": {
    "dev": "vite build --mode development && vite build --config vite.content.config.ts --mode development",
    "build": "vite build && vite build --config vite.content.config.ts",
    "zip": "npm run build && node scripts/zip.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "extpay": "^3.0.10",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.303",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
